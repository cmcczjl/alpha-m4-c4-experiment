  "limitations": [
    {
      "name": "未执行却生成检查产物（缺乏真实执行证据）",
      "mitigation": "在任何诊断性脚本或工具调用前，必须先实际执行命令并捕获完整的 stdout/stderr。若命令不可执行，立即报告错误并切换为探索任务，而非仅生成伪造产物。"
    },
    {
      "name": "盲目 pip 安装非 Python 工具",
      "mitigation": "在尝试安装工具前，先通过 which/ls 检查其是否为系统可执行文件或 Go 语言二进制。若非 Python 包，使用官方推荐的安装渠道（如 curl + tar、apt-get、brew 等）进行安装。"
    },
    {
      "name": "路径逻辑脆弱导致自动化验收失败",
      "mitigation": "使用 pathlib 或 os.path 的 robust API，避免硬编码绝对路径。先验证根目录结构（如 README.md、setup.py 等）是否存在，再执行路径相关操作。"
    },
    {
      "name": "门控拦截导致 stalled（连续失败后未及时诊断）",
      "mitigation": "在检测到连续失败后，自动触发前提验证子任务（路径、依赖、输入可用性），并将诊断结果记录为显式探索任务，而非仅阻止后续行动。"
    },
    {
      "name": "API 请求头缺失导致 403/401 误判",
      "mitigation": "调用任意公共 API 前，先查阅文档确认是否要求 User-Agent、Referer 等身份标识。遇到 403 时，优先补全 User-Agent 并携带自定义 contact 信息，而非默认判定为认证失败。"
    },
    {
      "name": "验证脚本与生成逻辑脱节，数据契约未闭环",
      "mitigation": "在开发初期实现'生产-消费'模式的强契约同步，先定义或同步更新 Schema，再编写数据生成逻辑，确保核心必填键（如 workflow_name, status, results）严格对齐。"
    },
    {
      "name": "未探测执行安全边界即验证脚本",
      "mitigation": "凡需运行脚本的任务，先确认命令可执行（检查安全策略/白名单，如 python3 路径拦截），再谈功能正确；必要时改为静态检查或调整允许命令。"
    },
    {
      "name": "Web 抓取与外部资源获取不稳定",
      "mitigation": "基准测试 web_fetch 仅 0.5 分，调用外部 API 或抓取网页时，需增加重试机制、User-Agent 轮询及降级策略（如使用缓存或静态快照），避免单次失败导致任务中断。"
    },
    {
      "name": "文档编写缺乏结构化深度",
