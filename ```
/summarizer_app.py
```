"""
Flask summarizer API using Hugging Face transformers.

Endpoint:
POST /summarize
Body: {"text": "long text to summarize"}
Response: {"summary": "short summary"}
"""

import os
from flask import Flask, request, jsonify
from transformers import pipeline, AutoTokenizer, AutoModelForSeq2SeqLM
import torch

app = Flask(__name__)

# Load summarization model (small, fast, no GPU required)
MODEL_NAME = "sshleifer/distilbart-cnn-12-6"

# Check if GPU available
DEVICE = 0 if torch.cuda.is_available() else -1

print(f"Loading model {MODEL_NAME} on device {DEVICE}...")

tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME)
summarizer = pipeline("summarization", model=model, tokenizer=tokenizer, device=DEVICE)

@app.route('/summarize', methods=['POST'])
def summarize():
    data = request.get_json()
    if not data or 'text' not in data:
        return jsonify({"error": "Missing 'text' field"}), 400
    text = data['text']
    if not isinstance(text, str) or len(text) == 0:
        return jsonify({"error": "'text' must be a non-empty string"}), 400

    try:
        # The summarizer may need a max_length; adjust as needed
        summary_list = summarizer(text, max_length=130, min_length=30, do_sample=False)
        summary = summary_list[0]['summary_text']
        return jsonify({"summary": summary})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route('/')
def hello():
    return "Summarizer API is running."

if __name__ == '__main__':
    # Run on all interfaces, port 5000
    app.run(host='0.0.0.0', port=5000, debug=False)
